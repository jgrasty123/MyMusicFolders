ay:block}\n  .mmf-hero__arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border:0;border-radius:50%;background:rgba(255,255,255,.85);font-size:30px;line-height:1;cursor:pointer;color:#000}\n  .mmf-hero__arrow--prev{left:12px}.mmf-hero__arrow--next{right:12px}\n  .mmf-hero__dots{position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:8px}\n  .mmf-hero__dots button{width:12px;height:12px;border-radius:50%;border:2px solid #e4b33a;background:#fff;padding:0;cursor:pointer}\n  .mmf-hero__dots button[aria-current=\"true\"]{background:#e4b33a}\n  @media (max-width:749px){.mmf-hero__arrow{display:none}}\n</style>\n<script>\n  (function(){\n    var root=document.currentScript.previousElementSibling.previousElementSibling;\n    if(!root||!root.matches('[data-mmf-hero]'))return;\n    var track=root.querySelector('[data-track]'),slides=track.children,dots=root.querySelector('[data-dots]'),i=0,timer;\n    for(var n=0;n<slides.length;n++){(function(n){var b=document.createElement('button');b.type='button';b.setAttribute('aria-label','Go to slide '+(n+1));b.onclick=function(){go(n);restart()};dots.appendChild(b)})(n)}\n    function mark(){[].forEach.call(dots.children,function(b,k){b.setAttribute('aria-current',k===i?'true':'false')})}\n    function go(n){i=(n+slides.length)%slides.length;track.scrollTo({left:track.clientWidth*i});mark()}\n    function restart(){clearInterval(timer);timer=setInterval(function(){go(i+1)},6000)}\n    root.querySelector('[data-prev]').onclick=function(){go(i-1);restart()};\n    root.querySelector('[data-next]').onclick=function(){go(i+1);restart()};\n    track.addEventListener('scroll',function(){var k=Math.round(track.scrollLeft/track.clientWidth);if(k!==i){i=k;mark()}},{passive:true});\n    root.addEventListener('mouseenter',function(){clearInterval(timer)});root.addEventListener('mouseleave',restart);\n    mark();restart();\n  })();\n</script>",
