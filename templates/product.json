    "product_tabs_mmf": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign sa_sku = product.selected_or_first_available_variant.sku\n  if sa_sku == blank\n    assign sa_sku = product.variants.first.sku\n  endif\n  assign show_emb = false\n  if product.tags contains 'embossing-available'\n    assign show_emb = true\n  endif\n-%}\n<div class=\"mmf-tabs\" data-mmf-tabs>\n  <div class=\"mmf-tabs__list\" role=\"tablist\" aria-label=\"Product information\">\n    <button type=\"button\" role=\"tab\" id=\"mmf-tab-desc\" aria-controls=\"mmf-panel-desc\" aria-selected=\"true\">Description</button>\n    <button type=\"button\" role=\"tab\" id=\"mmf-tab-warranty\" aria-controls=\"mmf-panel-warranty\" aria-selected=\"false\" tabindex=\"-1\">Warranty</button>\n    <button type=\"button\" role=\"tab\" id=\"mmf-tab-info\" aria-controls=\"mmf-panel-info\" aria-selected=\"false\" tabindex=\"-1\">Info</button>\n    {%- if show_emb -%}<button type=\"button\" role=\"tab\" id=\"mmf-tab-emb\" aria-controls=\"mmf-panel-emb\" aria-selected=\"false\" tabindex=\"-1\">Embossing</button>{%- endif -%}\n    <button type=\"button\" role=\"tab\" id=\"mmf-tab-reviews\" aria-controls=\"mmf-panel-reviews\" aria-selected=\"false\" tabindex=\"-1\">Reviews</button>\n    <button type=\"button\" role=\"tab\" id=\"mmf-tab-edu\" aria-controls=\"mmf-panel-edu\" aria-selected=\"false\" tabindex=\"-1\">Educator Pricing</button>\n  </div>\n\n  <div class=\"mmf-tabs__panel rte\" role=\"tabpanel\" id=\"mmf-panel-desc\" aria-labelledby=\"mmf-tab-desc\">{{ product.description }}</div>\n  <div class=\"mmf-tabs__panel rte\" role=\"tabpanel\" id=\"mmf-panel-warranty\" aria-labelledby=\"mmf-tab-warranty\" hidden>\n    <p>90-day warranty against manufacturer’s defects. If something isn’t right, <a href=\"/pages/contact\">contact us</a> or call <a href=\"tel:+18882660731\">888-266-0731</a>.</p>\n  </div>\n  <div class=\"mmf-tabs__panel\" role=\"tabpanel\" id=\"mmf-panel-info\" aria-labelledby=\"mmf-tab-info\" hidden>\n{%- assign v = product.selected_or_first_available_variant -%}\n<dl class=\"mmf-specs\">\n  {%- if v.sku != blank -%}<dt>SKU</dt><dd>{{ v.sku }}</dd>{%- endif -%}\n  {%- if v.barcode != blank -%}<dt>UPC</dt><dd>{{ v.barcode }}</dd>{%- endif -%}\n  <dt>Brand</dt><dd>{{ product.vendor }}</dd>\n  <dt>Condition</dt><dd>New</dd>\n  {%- if v.weight > 0 -%}<dt>Weight</dt><dd>{{ v.weight | weight_with_unit }}</dd>{%- endif -%}\n  {%- if product.metafields.custom.dimensions != blank -%}<dt>Dimensions</dt><dd>{{ product.metafields.custom.dimensions }}</dd>{%- endif -%}\n</dl>\n<style>.mmf-specs{display:grid;grid-template-columns:max-content 1fr;gap:6px 16px;margin:0}.mmf-specs dt{font-weight:600}.mmf-specs dd{margin:0}</style>\n  </div>\n  {%- if show_emb -%}\n  <div class=\"mmf-tabs__panel rte\" role=\"tabpanel\" id=\"mmf-panel-emb\" aria-labelledby=\"mmf-tab-emb\" hidden>\n{%- liquid\n  assign p_name = all_products['embossing-names-instruments']\n  assign p_repeat = all_products['embossing-repeated-text']\n  assign p_logo = all_products['embossing-custom-logo']\n  assign p_num = all_products['embossing-machine-numbers']\n-%}\n{%- if product.tags contains 'embossing-available' -%}\n<div class=\"mmf-emb-info\">\n  <p>Gold foil embossing is ordered right here on the folder page: choose <strong>Yes</strong> under “Add embossing to your folder?” above. Please allow up to two weeks for embossing.</p>\n  <h4>Names / Instruments{% if p_name.price %} &middot; {{ p_name.price | money }} each{% endif %}</h4>\n  <p>A personal name or instrument name on each folder. Add a note in the comments if there might be any confusion about which folders to imprint.</p>\n  <h4>Repeated text</h4>\n  <p>Your school, church or group name, the same on every folder (quantity discounts apply). Most often placed front middle center, but it can go anywhere on the folder.</p>\n  <h4>Custom logo</h4>\n  <p>Your school, church or group logo or crest, the same on every folder. Upload digital art when you order. Most often placed front middle center.</p>\n  <h4>Sequential numbering</h4>\n  <p>Gold foil numbers, usually in the upper right corner of the front cover, starting at 01. Tell us in the comments if you need specific numbers or a different starting number.</p>\n  <p><a href=\"/collections/embossing\">See embossing examples and fonts</a></p>\n</div>\n<style>.mmf-emb-info h4{margin:16px 0 4px;font-size:1rem}.mmf-emb-info p{margin:0 0 8px}</style>\n{%- else -%}\n<p>Gold foil embossing is available on our choral and instrumental folders. <a href=\"/collections/embossing\">See embossing options</a>.</p>\n{%- endif -%}\n  </div>\n  {%- endif -%}\n  <div class=\"mmf-tabs__panel\" role=\"tabpanel\" id=\"mmf-panel-reviews\" aria-labelledby=\"mmf-tab-reviews\" hidden>\n    <div id=\"SA_review_wrapper\"></div>\n  </div>\n  <div class=\"mmf-tabs__panel rte\" role=\"tabpanel\" id=\"mmf-panel-edu\" aria-labelledby=\"mmf-tab-edu\" hidden>\n    <p>Ordering for a whole choir, band or orchestra? <a href=\"/pages/music-educators-pricing\">See our music educator pricing</a> for bulk discounts and purchase orders.</p>\n  </div>\n</div>\n\n<style>\n  .mmf-tabs__list{display:flex;flex-wrap:nowrap;overflow-x:auto;border-bottom:1px solid #D9D7D2;gap:0;scrollbar-width:none}\n  .mmf-tabs__list::-webkit-scrollbar{display:none}\n  .mmf-tabs__list [role=\"tab\"]{flex:0 0 auto;background:none;border:1px solid transparent;border-bottom:0;margin-bottom:-1px;padding:12px 20px;font:inherit;font-weight:600;color:#6b6b6b;cursor:pointer;white-space:nowrap}\n  .mmf-tabs__list [role=\"tab\"][aria-selected=\"true\"]{color:#000;background:#fff;border-color:#D9D7D2;border-bottom:3px solid #E4B33A}\n  .mmf-tabs__list [role=\"tab\"]:hover{color:#000}\n  .mmf-tabs__panel{padding:24px 0;max-width:72rem}\n  .mmf-specs{display:grid;grid-template-columns:max-content 1fr;gap:6px 16px;margin:0}\n  .mmf-specs dt{font-weight:600}.mmf-specs dd{margin:0}\n  @media (max-width:749px){.mmf-tabs__list [role=\"tab\"]{padding:10px 14px}}\n</style>\n\n<script>\n  (function () {\n    var root = document.querySelector('[data-mmf-tabs]');\n    if (!root) return;\n    var tabs = [].slice.call(root.querySelectorAll('[role=\"tab\"]'));\n    function select(tab, focus) {\n      tabs.forEach(function (t) {\n        var on = t === tab;\n        t.setAttribute('aria-selected', on ? 'true' : 'false');\n        t.tabIndex = on ? 0 : -1;\n        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;\n      });\n      if (focus) tab.focus();\n    }\n    tabs.forEach(function (t, i) {\n      t.addEventListener('click', function () { select(t); });\n      t.addEventListener('keydown', function (e) {\n        var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;\n        if (n === null) return;\n        e.preventDefault();\n        select(tabs[(n + tabs.length) % tabs.length], true);\n      });\n    });\n    document.addEventListener('click', function (e) {\n      if (!e.target.closest('.sa_jump_to_reviews, a[href$=\"#SA_review_wrapper\"]')) return;\n      e.preventDefault();\n      select(document.getElementById('mmf-tab-reviews'));\n      root.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    });\n  })();\n</script>\n\n{%- if sa_sku != blank -%}\n<script>\n  var sa_product = {{ sa_sku | json }};\n  var sa_interval = 5000;\n  (function () {\n    function saLoad(src) { var js = document.createElement('script'); js.src = src; js.async = true; document.head.appendChild(js); }\n    if (typeof shopper_first === 'undefined') saLoad('https://www.shopperapproved.com/widgets/40782/product/' + encodeURIComponent(sa_product) + '/product-widget/7f2PnLzJC2hQ.js');\n    saLoad('https://www.shopperapproved.com/widgets/group2.0/40782.js');\n  })();\n</script>\n{%- endif -%}",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 16,
        "padding-block-end": 32
      }
