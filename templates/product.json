            "addons": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{%- liquid\n  assign addon_handles = ''\n  assign in_choral = product.collections | where: 'handle', 'choral-folders' | size\n  assign in_inst = product.collections | where: 'handle', 'instrumental-folders' | size\n  if in_choral > 0\n    assign addon_handles = 'elastic-cords,octavo-holders,three-ring-adapters,mmf-press-on-vinyl-envelopes'\n  elsif in_inst > 0\n    assign addon_handles = 'replacement-brass-corner-protectors-set-of-5,mmf-press-on-vinyl-envelopes,standaconda-music-stand-stabilizers'\n  endif\n  assign addon_list = addon_handles | split: ','\n-%}\n{%- if addon_list.size > 0 -%}\n<fieldset class=\"mmf-addons\" data-mmf-addons>\n  <legend class=\"mmf-addons__legend\">Complete your folder</legend>\n  {%- for h in addon_list -%}\n    {%- assign ap = all_products[h] -%}\n    {%- if ap and ap.available and ap.handle != product.handle -%}\n      {%- assign av = ap.selected_or_first_available_variant -%}\n      <label class=\"mmf-addons__item\">\n        <input type=\"checkbox\" value=\"{{ av.id }}\" data-addon>\n        {%- if ap.featured_image -%}{{ ap.featured_image | image_url: width: 120 | image_tag: class: 'mmf-addons__img', loading: 'lazy', alt: '' }}{%- endif -%}\n        <span class=\"mmf-addons__title\">{{ ap.title | escape }}{% if ap.variants.size > 1 %} <small>({{ av.title | escape }})</small>{% endif %}</span>\n        <span class=\"mmf-addons__price\">+{{ av.price | money }}</span>\n      </label>\n    {%- endif -%}\n  {%- endfor -%}\n  <p class=\"mmf-addons__note\">Checked items are added to your cart with this folder.</p>\n</fieldset>\n<style>\n  .mmf-addons{border:1px solid #D9D7D2;padding:12px 14px 8px;margin:0}\n  .mmf-addons__legend{font-weight:700;padding:0 6px}\n  .mmf-addons__item{display:grid;grid-template-columns:auto 44px 1fr auto;align-items:center;gap:10px;padding:6px 0;cursor:pointer}\n  .mmf-addons__item input{width:18px;height:18px;accent-color:#000}\n  .mmf-addons__img{width:44px;height:44px;object-fit:contain;background:#F4F4F2}\n  .mmf-addons__title{font-size:.9375rem;line-height:1.3}\n  .mmf-addons__price{font-weight:700;white-space:nowrap}\n  .mmf-addons__note{font-size:.8125rem;opacity:.75;margin:4px 0 0}\n</style>\n<script>\n  (function () {\n    var box = document.querySelector('[data-mmf-addons]');\n    if (!box || box.dataset.bound) return;\n    box.dataset.bound = '1';\n    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';\n    // Capture phase on window: runs before Horizon's document-level submit handler and the embossing handler.\n    window.addEventListener('submit', function (e) {\n      var form = e.target;\n      if (!form || !form.id || form.id.indexOf('BuyButtons-ProductForm-') !== 0) return;\n      if (form.dataset.mmfAddonsDone === '1') return;\n      var picked = [].slice.call(box.querySelectorAll('[data-addon]:checked'));\n      if (!picked.length) return;\n      e.preventDefault();\n      e.stopImmediatePropagation();\n      var items = picked.map(function (c) { return { id: Number(c.value), quantity: 1 }; });\n      fetch(root + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: items }) })\n        .catch(function () {})\n        .then(function () {\n          picked.forEach(function (c) { c.checked = false; });\n          // Re-submit on a fresh task so the browser dispatches a new submit event\n          // and the theme (and embossing, if chosen) add the folder as usual.\n          setTimeout(function () {\n            form.dataset.mmfAddonsDone = '1';\n            if (form.requestSubmit) form.requestSubmit(); else form.submit();\n            form.dataset.mmfAddonsDone = '';\n          }, 0);\n        });\n    }, true);\n  })();\n</script>\n{%- endif -%}"
              },
