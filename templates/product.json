              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "<div class=\"mmf-share\" aria-label=\"Share this product\">\n  {%- assign u = shop.url | append: product.url | url_encode -%}{%- assign tt = product.title | url_encode -%}\n  <span>Share:</span>\n  <a href=\"https://www.facebook.com/sharer/sharer.php?u={{ u }}\" target=\"_blank\" rel=\"noopener\">Facebook</a>\n  <a href=\"https://twitter.com/intent/tweet?url={{ u }}&text={{ tt }}\" target=\"_blank\" rel=\"noopener\">X</a>\n  <a href=\"https://www.pinterest.com/pin/create/button/?url={{ u }}&description={{ tt }}\" target=\"_blank\" rel=\"noopener\">Pinterest</a>\n  <a href=\"https://www.linkedin.com/sharing/share-offsite/?url={{ u }}\" target=\"_blank\" rel=\"noopener\">LinkedIn</a>\n  <a href=\"mailto:?subject={{ tt }}&body={{ u }}\">Email</a>\n</div>\n<style>.mmf-share{display:flex;flex-wrap:wrap;gap:14px;font-size:.875rem;align-items:center}.mmf-share a{color:inherit;text-decoration:underline;text-underline-offset:2px}</style>\n<style>.shopify-payment-button__button--unbranded,.shopify-payment-button__more-options{display:none!important}</style>"
