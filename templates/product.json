    "why_buy_mmf": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mmf-why\">\n  <h2 class=\"mmf-why__h\">Why musicians buy from MyMusicFolders</h2>\n  <div class=\"mmf-why__grid\">\n    <div><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z\"/></svg><h3>5-star rated</h3><p>Thousands of verified reviews on <a href=\"https://www.shopperapproved.com/reviews/mymusicfolders.com\" target=\"_blank\" rel=\"noopener\">Shopper Approved</a>.</p></div>\n    <div><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"1\"/><path d=\"M8 9h8M9 13h6\"/></svg><h3>Personalized in gold foil</h3><p>Names, numbers, logos and crests embossed in-house in Missoula.</p></div>\n    <div><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\"/></svg><h3>Real people on the phone</h3><p>Call <a href=\"tel:+18882660731\">888-266-0731</a>, Monday to Friday, 9 to 5 Mountain.</p></div>\n    <div><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 9l10-5 10 5-10 5z\"/><path d=\"M6 11v5c3 2 9 2 12 0v-5\"/></svg><h3>Schools &amp; churches welcome</h3><p>Purchase orders and invoicing for institutions. Call or email to set it up.</p></div>\n  </div>\n</div>\n<style>\n  .mmf-why{border-top:1px solid #D9D7D2;padding-top:32px}\n  .mmf-why__h{font-size:1.375rem;margin:0 0 20px;text-align:center}\n  .mmf-why__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}\n  .mmf-why__grid svg{color:#E4B33A;margin:0 auto 8px;display:block}\n  .mmf-why__grid h3{font-size:1rem;margin:0 0 6px}\n  .mmf-why__grid p{font-size:.875rem;margin:0;opacity:.85}\n  .mmf-why a{color:inherit;text-decoration:underline;text-underline-offset:2px}\n  @media (max-width:749px){.mmf-why__grid{grid-template-columns:1fr 1fr;gap:20px 14px}}\n</style>",
        "background_color": "",
